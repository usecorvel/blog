<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<title>{% if title %}{{ title }} | {% endif %}{{ site.title }}</title>
		<meta name="description" content="{{ description or site.description }}">
		<link rel="canonical" href="{{ page.url | absoluteUrl(site.url) }}">
		<meta property="og:title" content="{{ title or site.title }}">
		<meta property="og:description" content="{{ description or site.description }}">
		<meta property="og:url" content="{{ page.url | absoluteUrl(site.url) }}">
		<meta property="og:type" content="{% if layout == 'post.njk' %}article{% else %}website{% endif %}">
		<link rel="icon" type="image/svg+xml" href="/img/favicon.svg">
		<link rel="stylesheet" href="/css/blog.css">
	</head>
	<body>
		<header class="site-header">
			<div class="wrap header-inner">
				<a href="/" class="brand">
					<img src="/img/logo.svg" alt="Corvel" width="120" height="32">
					<span class="brand-tag">Blog</span>
				</a>
				<nav>
					<a href="/about/">About the blog</a>
					<a href="{{ site.mainSite }}/how-it-works">How Corvel works</a>
					<a href="{{ site.mainSite }}/plans">Pricing</a>
					<a href="{{ site.mainSite }}/contact" class="button">Book a demo</a>
				</nav>
			</div>
		</header>
		<main class="wrap">
			{{ content | safe }}
		</main>
		<footer class="site-footer">
			<div class="wrap footer-inner">
				<p>
					Corvel books, reschedules and fills cancellations by text for clinics and salons.
					<a href="{{ site.mainSite }}/">Visit usecorvel.com</a>
				</p>
				<p class="small">
					<a href="{{ site.mainSite }}/for-clinics">For clinics</a> ·
					<a href="{{ site.mainSite }}/for-salons">For salons</a> ·
					<a href="{{ site.mainSite }}/about">About Corvel</a> ·
					<a href="/sitemap.xml">Sitemap</a>
				</p>
				<p class="small">© {% year %} Corvel Labs, Inc.</p>
			</div>
		</footer>
	</body>
</html>
